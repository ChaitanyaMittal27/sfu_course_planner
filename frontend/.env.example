# frontend .env.example
# Copy this file to .env.local and replace placeholder values.

# for NEXT_PUBLIC_API_URL
#   http://localhost:5000 is for dev
#   https://api.sfucourseplanner.com for prod

# for NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
#   for prod, get db values.
#   for dev, use supabase cli [npx supabase@latest status]

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000