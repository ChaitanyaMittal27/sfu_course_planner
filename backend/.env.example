# backend .env.example
# Copy this file to .env.local and replace placeholder values.

# for DB_____ and SUPABASE_____ values
#   for prod, get db values.
#   for dev, use supabase cli [npx supabase@latest status]

DB_URL_NEW=jdbc:postgresql://your-host:5432/postgres
DB_USER_NEW=your-database-user
DB_PASS_NEW=your-database-password
SUPABASE_URL_NEW=https://your-project.supabase.co
SUPABASE_KEY_NEW=your-supabase-anon-key
RESEND_API_KEY=your-resend-api-key
SERVER_PORT=5000